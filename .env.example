# ㈜와이드가드 홈페이지 — Vercel 환경변수 예시
# Vercel 프로젝트 > Settings > Environment Variables 에 같은 이름으로 넣으세요.
# (.env 파일은 배포에 포함되지 않습니다. 이 파일은 이름을 적어 두기 위한 예시입니다.)

# ── 알림 문자 수신 (기본값: 대표이사 김정환, 사내이사 김종연) ──
# 비워 두면 두 번호로 발송됩니다. 다른 번호로 받으려면 "01000000000,01000000000" 형식으로 입력.
NOTIFY_PHONES=01088585559,01093287814

# ── 사용할 문자 서비스: solapi 또는 aligo ──
# 비워 두면 아래 키 중 설정된 쪽을 자동으로 사용합니다.
SMS_PROVIDER=solapi

# ── (A) 솔라피 Solapi ── https://solapi.com
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=          # 솔라피 콘솔에 사전 등록·승인된 발신번호 (예: 0319452001)

# ── (B) 알리고 Aligo ── https://smartsms.aligo.in
# SMS_PROVIDER=aligo 인 경우 아래 세 개를 사용합니다.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=           # 알리고에 사전 등록된 발신번호
# ALIGO_TESTMODE=y      # 테스트(모의) 발송으로 확인할 때만
